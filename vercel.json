{
  "installCommand": "bash scripts/install-vercel-system-deps.sh && npm install",
  "redirects": [
    {
      "source": "/",
      "destination": "/ro",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!images/|assets/|logo|logo_2|hero_image|doctor-image|placeholder|sitemap\\.xml|favicon\\.ico|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
